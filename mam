#!/bin/rc
# use sam as a pager for man
progname=$0
sect=$1
pg=$2
if (~ $2 '') {
	pg=$1
}

fn fail {
	echo could not put $loc
	rm $loc
	exit
}

fn usage {
	echo usage: $progname CMD
	exit usage
}

fn opn {
	if (~ $pg $1) {
		loc=/tmp/man-$pg
		man $pg > $loc
	}
	if not {
		loc=/tmp/man-$sect-$pg
		man $sect $pg > $loc
	}
	echo opening $loc
	sam $loc
	rm $loc && echo deleted $loc
}

switch($pg) {
	case ''
		usage
	case *
		opn
}
